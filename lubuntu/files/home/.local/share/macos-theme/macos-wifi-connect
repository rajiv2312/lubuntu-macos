#!/usr/bin/env python3
"""macOS-style Wi-Fi password dialog using Qt/KDE"""
import sys
import subprocess
import os

try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, GLib
except ImportError:
    # Fallback to kdialog if GTK not available
    os.execvp('kdialog', ['kdialog', '--password', f'Enter password for "{sys.argv[1] if len(sys.argv) > 1 else "Network"}":'])

class WiFiPasswordDialog(Gtk.Dialog):
    def __init__(self, ssid):
        super().__init__(title=f'Wi-Fi: {ssid}', modal=True, destroy_with_parent=True)
        self.ssid = ssid
        self.password = None

        self.set_default_size(350, 180)
        self.set_resizable(False)
        self.set_type_hint(3)  # UTILITY

        # Main content
        content = self.get_content_area()
        content.set_margin_top(20)
        content.set_margin_start(20)
        content.set_margin_end(20)
        content.set_margin_bottom(20)
        content.set_spacing(16)

        # Network name
        name_label = Gtk.Label()
        name_label.set_markup(f'<b>Connect to "{ssid}"</b>')
        name_label.set_halign(Gtk.Align.START)
        content.pack_start(name_label, False, False, 0)

        # Password label
        pwd_label = Gtk.Label(label='Password:')
        pwd_label.set_halign(Gtk.Align.START)
        content.pack_start(pwd_label, False, False, 0)

        # Password field
        self.pwd_entry = Gtk.Entry()
        self.pwd_entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.pwd_entry.set_visibility(False)
        self.pwd_entry.connect('activate', lambda *_: self.response(Gtk.ResponseType.OK))
        content.pack_start(self.pwd_entry, False, False, 0)

        # Buttons
        self.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                        Gtk.STOCK_OK, Gtk.ResponseType.OK)

        # Style the OK button
        ok_btn = self.get_widget_for_response(Gtk.ResponseType.OK)
        ok_btn.get_style_context().add_class('suggested-action')

        self.show_all()
        self.pwd_entry.grab_focus()

def main():
    if len(sys.argv) < 2:
        sys.exit(1)

    ssid = sys.argv[1]
    os.environ['DISPLAY'] = os.environ.get('DISPLAY', ':0')

    dialog = WiFiPasswordDialog(ssid)
    response = dialog.run()
    password = dialog.pwd_entry.get_text() if response == Gtk.ResponseType.OK else None
    dialog.destroy()

    if not password:
        sys.exit(1)

    # Connect to the network
    result = subprocess.run(
        ['nmcli', 'device', 'wifi', 'connect', ssid, 'password', password],
        capture_output=True, text=True
    )

    sys.exit(result.returncode)

if __name__ == '__main__':
    main()
