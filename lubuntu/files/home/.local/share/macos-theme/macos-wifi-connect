#!/usr/bin/env python3
"""macOS-style Wi-Fi password dialog"""
import sys
import subprocess
import os

try:
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk
except ImportError:
    sys.exit(1)

class WiFiPasswordDialog(Gtk.Dialog):
    def __init__(self, ssid):
        super().__init__(title="", modal=True, destroy_with_parent=True)
        self.ssid = ssid

        # Window setup - clean macOS style
        self.set_decorated(False)
        self.set_default_size(400, 220)
        self.set_position(Gtk.WindowPosition.CENTER_ALWAYS)
        self.set_keep_above(True)

        # Apply CSS styling
        css_provider = Gtk.CssProvider()
        css_data = b"""
        window { background-color: #f5f5f7; }
        * { font-family: 'Inter', sans-serif; font-size: 13px; color: #1d1d1f; }
        entry {
            background-color: #ffffff;
            border: 1px solid #d5d5d0;
            border-radius: 6px;
            padding: 8px 12px;
        }
        entry:focus { border-color: #0a84ff; box-shadow: 0 0 0 2px rgba(10, 132, 255, 0.2); }
        button {
            background-color: #e5e5ea;
            border: none;
            border-radius: 6px;
            padding: 6px 16px;
        }
        button:hover { background-color: #d5d5dc; }
        button.suggested-action {
            background-color: #0a84ff;
            color: white;
        }
        button.suggested-action:hover { background-color: #147EFB; }
        """
        css_provider.load_from_data(css_data)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            css_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Get content area
        content = self.get_content_area()
        content.set_margin_top(24)
        content.set_margin_start(24)
        content.set_margin_end(24)
        content.set_margin_bottom(20)
        content.set_spacing(16)

        # Network name section
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        title_label = Gtk.Label()
        title_label.set_markup("<b>Enter password</b>")
        title_label.set_halign(Gtk.Align.START)
        title_box.pack_start(title_label, False, False, 0)

        ssid_label = Gtk.Label(label=f'Network: "{ssid}"')
        ssid_label.set_halign(Gtk.Align.START)
        ssid_label.get_style_context().add_class("dim-label")
        title_box.pack_start(ssid_label, False, False, 0)
        content.pack_start(title_box, False, False, 0)

        # Password input
        pwd_label = Gtk.Label(label="Password:")
        pwd_label.set_halign(Gtk.Align.START)
        content.pack_start(pwd_label, False, False, 0)

        self.pwd_entry = Gtk.Entry()
        self.pwd_entry.set_visibility(False)
        self.pwd_entry.set_placeholder_text("Enter network password")
        self.pwd_entry.connect('activate', lambda *_: self.response(Gtk.ResponseType.OK))
        content.pack_start(self.pwd_entry, False, False, 0)

        content.show_all()

        # Buttons - use dialog's built-in button area
        self.add_buttons(
            "Cancel", Gtk.ResponseType.CANCEL,
            "Connect", Gtk.ResponseType.OK
        )

        # Style the Connect button
        ok_btn = self.get_widget_for_response(Gtk.ResponseType.OK)
        if ok_btn:
            ok_btn.get_style_context().add_class("suggested-action")

        self.pwd_entry.grab_focus()

def main():
    if len(sys.argv) < 2:
        sys.exit(1)

    ssid = sys.argv[1]
    os.environ['DISPLAY'] = os.environ.get('DISPLAY', ':0')

    try:
        dialog = WiFiPasswordDialog(ssid)
        response = dialog.run()
        password = dialog.pwd_entry.get_text() if response == Gtk.ResponseType.OK else None
        dialog.destroy()

        if not password:
            sys.exit(1)

        # Connect to network
        result = subprocess.run(
            ['nmcli', 'device', 'wifi', 'connect', ssid, 'password', password],
            capture_output=True, text=True, timeout=30
        )
        sys.exit(result.returncode)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == '__main__':
    main()
