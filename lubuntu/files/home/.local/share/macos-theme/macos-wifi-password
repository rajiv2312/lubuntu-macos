#!/bin/bash
# macOS-style Wi-Fi password prompt - small dialog instead of separate window
# Usage: macos-wifi-password <SSID>

# Log everything for debugging
LOG="/tmp/macos-wifi-password.log"
{
    echo "[$(date)] === macos-wifi-password called ==="
    echo "[$(date)] Args: $@"
    echo "[$(date)] DISPLAY=$DISPLAY"
    echo "[$(date)] PWD=$PWD"

    SSID="$1"

    if [ -z "$SSID" ]; then
        echo "[$(date)] ERROR: No SSID provided"
        exit 1
    fi

    echo "[$(date)] SSID=$SSID"
    echo "[$(date)] Calling: kdialog --password \"Enter password for $SSID\""

    # Show password prompt using kdialog
    PASSWORD=$(kdialog --password "Enter password for \"$SSID\":" 2>&1)
    EXIT_CODE=$?

    echo "[$(date)] kdialog returned: $EXIT_CODE"
    echo "[$(date)] Password length: ${#PASSWORD}"

    if [ -z "$PASSWORD" ]; then
        echo "[$(date)] No password entered, exiting"
        exit 1
    fi

    echo "[$(date)] Attempting to connect..."
    nmcli device wifi connect "$SSID" password "$PASSWORD" --wait 90
    EXIT=$?
    echo "[$(date)] nmcli returned: $EXIT"

    exit $EXIT
} >> "$LOG" 2>&1
