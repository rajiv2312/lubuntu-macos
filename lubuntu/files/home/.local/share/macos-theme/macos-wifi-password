#!/bin/bash
# macOS-style Wi-Fi password prompt - small dialog instead of separate window
# Usage: macos-wifi-password <SSID>

SSID="$1"

if [ -z "$SSID" ]; then
    exit 1
fi

# Ensure DISPLAY is set for kdialog
export DISPLAY="${DISPLAY:-:0}"

# Show password prompt using kdialog (Qt-based, matches macOS theme better than Zenity)
PASSWORD=$(kdialog --password "Enter password for \"$SSID\":" 2>/dev/null)

if [ -z "$PASSWORD" ]; then
    exit 1
fi

# Try to connect with the password
nmcli device wifi connect "$SSID" password "$PASSWORD" --wait 90 2>/dev/null

exit $?
