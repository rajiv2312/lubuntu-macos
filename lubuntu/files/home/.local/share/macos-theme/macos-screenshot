#!/bin/bash
# macOS-style screenshot tool for Linux
# - Shows crosshair cursor
# - Select area with mouse
# - Auto-saves with timestamp
# - Copies path to clipboard
# - Shows notification

set -e

SCREENSHOT_DIR="$HOME/Pictures"
mkdir -p "$SCREENSHOT_DIR"

TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
FILENAME="Screenshot_$TIMESTAMP.png"
FILEPATH="$SCREENSHOT_DIR/$FILENAME"

# Use ImageMagick's import for interactive selection
# -pause 0 = no delay, crosshair appears immediately
import -pause 0 "$FILEPATH" 2>/dev/null || {
    # User cancelled (pressed Escape or Ctrl+C)
    exit 0
}

# Copy the file path to clipboard
echo -n "$FILEPATH" | xclip -selection clipboard 2>/dev/null || \
echo -n "$FILEPATH" | xsel -b 2>/dev/null || true

# Show notification (using LXQt notification daemon)
notify-send -i "screenshot" "Screenshot Saved" "$FILENAME" 2>/dev/null || true

# Optional: Show the file manager if desired
# pcmanfm-qt "$SCREENSHOT_DIR" &
