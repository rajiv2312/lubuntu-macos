#!/bin/bash
# macOS-style screenshot using screengrab
# - Single instance (no duplicate windows)
# - No help text (minimized mode)
# - Clean region selection only
# - Auto-saves to ~/Pictures/

# Check if screengrab is already running
if pgrep -x "screengrab" > /dev/null; then
    # Already running - just exit to avoid duplicate windows
    exit 0
fi

# Launch screengrab in region selection + minimized mode
# -r = region selection (interactive)
# -m = minimized (hides main window, no help text)
screengrab -r -m

# Show notification when done
notify-send -i "screenshot" "Screenshot Saved" "Saved to Pictures/" 2>/dev/null || true
