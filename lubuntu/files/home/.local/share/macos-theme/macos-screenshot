#!/bin/bash
# Screenshot tool - works with import or screengrab

SCREENSHOT_DIR="$HOME/Pictures"
mkdir -p "$SCREENSHOT_DIR"

TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
FILENAME="Screenshot_$TIMESTAMP.png"
FILEPATH="$SCREENSHOT_DIR/$FILENAME"

# Try import (ImageMagick) first - most reliable
if command -v import &> /dev/null; then
    import -pause 0 "$FILEPATH" 2>/dev/null
else
    # Fallback to screengrab
    screengrab -r
    # screengrab saves to its configured location - find and copy it
    # Look for most recent PNG in common locations
    FOUND=$(find ~/ -name "*.png" -type f -mmin -1 2>/dev/null | sort -rt '_' -k1 | head -1)
    if [ -n "$FOUND" ]; then
        cp "$FOUND" "$FILEPATH"
    fi
fi

# If screenshot was created, open it in Finder and copy to clipboard
if [ -f "$FILEPATH" ]; then
    # Copy to clipboard
    xclip -selection clipboard -t image/png < "$FILEPATH" 2>/dev/null || true

    # Open file manager (Finder) showing the Pictures folder
    pcmanfm-qt "$SCREENSHOT_DIR" &

    # Notification disabled for minimal notification mode
fi
