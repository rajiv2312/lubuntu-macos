#!/bin/bash
# macOS-style screenshot using screengrab
# - Region selection mode: select area with mouse
# - Auto-saves to ~/Pictures/
# - Shows notification
# - No extra prompts or windows

SCREENSHOT_DIR="$HOME/Pictures"
mkdir -p "$SCREENSHOT_DIR"

TIMESTAMP=$(date '+%Y-%m-%d_%H-%M-%S')
FILENAME="Screenshot_$TIMESTAMP.png"
FILEPATH="$SCREENSHOT_DIR/$FILENAME"

# Use screengrab in region mode
# -r = region selection, -n = no window, saves and exits
screengrab -r

# The screenshot is saved automatically by screengrab
# Show notification
notify-send -i "screenshot" "Screenshot Saved" "Saved to Pictures/" 2>/dev/null || true
