#!/bin/sh
# macOS-style screen lock: show the macOS login screen (SDDM) while this session keeps
# running; logging in there returns to this session. Falls back to xscreensaver's lock
# whenever the login screen can't be used safely. Undo: ~/.local/share/macos-theme/undo-macos-lock

fallback() { exec xscreensaver-command -lock; }

# Only safe while SDDM's login screen blocks Ctrl+Alt+F-keys (line added to Xsetup);
# an SDDM update could remove it, so check every time.
grep -q '^setxkbmap -option srvrkeys:none' /usr/share/sddm/scripts/Xsetup 2>/dev/null || fallback

can=$(busctl --system get-property org.freedesktop.DisplayManager /org/freedesktop/DisplayManager/Seat0 \
      org.freedesktop.DisplayManager.Seat CanSwitch 2>/dev/null)
[ "$can" = "b true" ] || fallback

before=$(cat /sys/class/tty/tty0/active 2>/dev/null)
busctl --system call org.freedesktop.DisplayManager /org/freedesktop/DisplayManager/Seat0 \
       org.freedesktop.DisplayManager.Seat SwitchToGreeter >/dev/null 2>&1 || fallback

# Wait until the login screen has actually taken over the display (important before
# suspend: the lid must not close while this session is still on screen).
i=0
while [ $i -lt 50 ]; do
    now=$(cat /sys/class/tty/tty0/active 2>/dev/null)
    [ -n "$now" ] && [ "$now" != "$before" ] && exit 0
    sleep 0.1; i=$((i + 1))
done
fallback   # the switch did not happen within 5 s: lock this session the classic way
