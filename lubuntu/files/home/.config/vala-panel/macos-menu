[core-version-1]
units=['menubar','apple','appmenu']

[global]
is-dark=false
is-custom=true
logout-command='lxqt-leave --logout'
shutdown-command='lxqt-leave --shutdown'

[menubar]
object-type='toplevel'
panel-gravity='north-left'
monitor=-1
height=30
width=60
is-dynamic=false
strut=true
dock=true
icon-size=18
use-toolbar-appearance=false
use-background-color=true
background-color='rgb(242,242,242)'
use-foreground-color=true
foreground-color='rgb(29,29,31)'
use-font=true
font='Inter 16'
autohide=false

[apple]
toplevel-id='menubar'
plugin-type='org.valapanel.menumodel'
position=0
pack-type='start'
icon-name='@HOME@/.local/share/macos-theme/apple-menu-dark.svg'
menu-caption=''
is-menu-bar=false
is-system-menu=false
is-internal-menu=false
model-file='@HOME@/.local/share/macos-theme/apple-menu.ui'
object-type='applet'

[appmenu]
toplevel-id='menubar'
plugin-type='org.valapanel.appmenu'
position=1
pack-type='start'
bold-application-name=true
compact-mode=false
object-type='applet'
